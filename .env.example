# ============================================================================
# Student Equipment Resale Platform - Root Environment Configuration
# ============================================================================

# Backend Port & URL
PORT=5000
VITE_API_URL=http://localhost:5000/api/v1

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=student_equipment_db
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/student_equipment_db

# JWT Security
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=12
