# ============================================================================
# Student Equipment Resale Platform - Backend Environment Configuration
# ============================================================================

# Server Environment & Port (Render will automatically assign PORT)
NODE_ENV=development
PORT=5000

# Frontend & CORS Configuration (Provide Vercel frontend URL in production)
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Connection (Neon PostgreSQL / Cloud PostgreSQL)
# In production on Render, set DATABASE_URL from your Neon console
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Local PostgreSQL Fallback (Used only when DATABASE_URL is not set)

DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=10000

# Authentication & JWT Security
JWT_SECRET=change_this_in_production
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=12

# Payment Gateway Configuration - bKash Sandbox (Optional / Mocked in dev)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=your_bkash_app_key_placeholder
BKASH_APP_SECRET=your_bkash_app_secret_placeholder
BKASH_USERNAME=your_bkash_username_placeholder
BKASH_PASSWORD=your_bkash_password_placeholder
BKASH_CALLBACK_URL=http://localhost:5000/api/v1/payments/callback/bkash
BKASH_SANDBOX_MODE=true

# Payment Gateway Configuration - Nagad Sandbox (Optional / Mocked in dev)
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs
NAGAD_MERCHANT_ID=your_nagad_merchant_id_placeholder
NAGAD_MERCHANT_NUMBER=your_nagad_merchant_number_placeholder
NAGAD_PUBLIC_KEY=your_nagad_public_key_placeholder
NAGAD_PRIVATE_KEY=your_nagad_private_key_placeholder
NAGAD_CALLBACK_URL=http://localhost:5000/api/v1/payments/callback/nagad
NAGAD_SANDBOX_MODE=true
