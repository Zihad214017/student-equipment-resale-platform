# ============================================================================
# Student Equipment Resale Platform - Backend Environment Configuration
# ============================================================================

# Server Environment
NODE_ENV=development
PORT=5000

# Database Configuration (PostgreSQL 15+)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=student_equipment_db
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/student_equipment_db
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=2000

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=12

# Payment Gateway Configuration - bKash
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_CALLBACK_URL=http://localhost:5000/api/v1/payments/callback/bkash
BKASH_SANDBOX_MODE=true

# Payment Gateway Configuration - Nagad
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs
NAGAD_MERCHANT_ID=your_nagad_merchant_id
NAGAD_MERCHANT_NUMBER=your_nagad_merchant_number
NAGAD_PUBLIC_KEY=your_nagad_public_key
NAGAD_PRIVATE_KEY=your_nagad_private_key
NAGAD_CALLBACK_URL=http://localhost:5000/api/v1/payments/callback/nagad
NAGAD_SANDBOX_MODE=true
